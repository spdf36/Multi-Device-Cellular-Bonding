# PC-Hub Environment Configuration
# Copy this to .env and adjust values as needed

# API / Dashboard server port
PORT=3001

# HTTP CONNECT proxy port (listen on 127.0.0.1)
PROXY_PORT=8080

# SOCKS5 proxy port (listen on 127.0.0.1)
SOCKS_PORT=1080

# WebSocket tunnel server port (phones connect here, listen on 0.0.0.0)
HUB_WS_PORT=9000

# Default load-balancing strategy: round-robin | weighted-round-robin | least-connections | least-latency
BALANCE_STRATEGY=least-connections

# PING interval in milliseconds (for latency measurement)
PING_INTERVAL_MS=5000

# Log level: error | warn | info | debug
LOG_LEVEL=info
